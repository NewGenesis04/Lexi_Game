{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24",
    "pnpm": "10"
  },
  "steps": {
    "install": {
      "inputs": [
        { "step": "packages:mise" },
        {
          "local": true,
          "include": [
            "frontend/package.json",
            "frontend/pnpm-lock.yaml",
            "frontend/pnpm-workspace.yaml"
          ]
        }
      ],
      "commands": [
        "pnpm install --frozen-lockfile",
        "npm install -g serve --prefix /app/.tools"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" },
        {
          "local": true,
          "include": [
            "frontend"
          ],
          "exclude": [
            "frontend/node_modules",
            "frontend/dist"
          ]
        }
      ],
      "commands": [ "cd frontend && pnpm run build" ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      {
        "step": "build",
        "include": [ "frontend/dist", ".tools" ]
      }
    ],
    "startCommand": "/app/.tools/bin/serve -s /app/frontend/dist -l ${PORT:-3000}"
  }
}
