{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24",
    "pnpm": "10"
  },
  "deploy": {
    "inputs": [
      "...",
      {
        "step": "packages:mise",
        "include": ["/mise/installs/pnpm", "/mise/shims"]
      }
    ],
    "paths": [ "/mise/shims" ],
    "startCommand": "pnpm dlx srvx --port 3000 --host 0.0.0.0 --static dist --prod"
  }
}
